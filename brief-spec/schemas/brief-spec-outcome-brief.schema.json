{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luanmorenommaciel/brief-spec/releases/download/v0.5.0/brief-spec-outcome-brief.schema.json",
  "title": "Brief-Spec Outcome Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "outcome",
    "human_action",
    "proof",
    "gaps",
    "next",
    "open"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "outcome-brief" },
    "status": { "enum": ["DONE", "REVIEW", "DECIDE", "BLOCKED", "FAILED"] },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 500 },
    "human_action": { "type": ["string", "null"] },
    "proof": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "brief-spec-evidence.schema.json" }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "next": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
    "open": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
  }
}
