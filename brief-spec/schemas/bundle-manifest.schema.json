{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefspec.dev/schemas/bundle-manifest.schema.json",
  "title": "BriefSpec bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "briefspec_version",
    "delivery_schema_version",
    "canonical_sha256",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "briefspec-bundle-manifest" },
    "briefspec_version": { "type": "string", "minLength": 1 },
    "delivery_schema_version": { "const": "1.0" },
    "canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "path",
          "media_type",
          "size_bytes",
          "sha256",
          "renderer_version"
        ],
        "properties": {
          "format": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^[^/]+$" },
          "media_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "renderer_version": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
