{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefspec.dev/schemas/session-checkpoint.schema.json",
  "title": "BriefSpec Session Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "mode", "headline", "proof", "next"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "session-checkpoint"
    },
    "mode": {
      "enum": ["orient", "teach", "spoken"]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "current_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mental_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "what_changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "example": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "watch_outs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "open": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "script": {
      "type": ["string", "null"],
      "maxLength": 2400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "orient"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["current_state", "completed", "decisions", "open"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "teach"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": [
          "mental_model",
          "why_it_matters",
          "what_changed",
          "example",
          "watch_outs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "spoken"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["script"]
      }
    }
  ]
}
