{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://briefspec.dev/schemas/outcome-brief.schema.json",
  "title": "BriefSpec Outcome Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "outcome",
    "human_action",
    "proof",
    "gaps",
    "next",
    "open"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "outcome-brief"
    },
    "status": {
      "enum": ["DONE", "REVIEW", "DECIDE", "BLOCKED", "FAILED"]
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "human_action": {
      "type": ["string", "null"]
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "open": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}
