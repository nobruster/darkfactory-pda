{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luanmorenommaciel/brief-spec/releases/download/v0.5.0/brief-spec-delivery-receipt.schema.json",
  "title": "Brief-Spec delivery receipt 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "delivery_id",
    "format",
    "destination",
    "content_sha256",
    "brief_spec_version",
    "delivery_schema_version",
    "renderer_versions",
    "verification_level",
    "delivered_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "kind": { "const": "brief-spec-delivery-receipt" },
    "status": { "enum": ["pending", "delivered"] },
    "delivery_id": { "type": ["string", "null"] },
    "format": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "const": "local" },
        "locator": { "type": ["string", "null"] }
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "brief_spec_version": { "type": ["string", "null"] },
    "delivery_schema_version": { "const": "2.0" },
    "renderer_versions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "verification_level": {
      "enum": ["structural", "resolved", "rendered", "delivered"]
    },
    "delivered_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
