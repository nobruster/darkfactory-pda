{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luanmorenommaciel/brief-spec/schemas/brief-spec-lesson-proposal.schema.json",
  "title": "Brief-Spec Chronicle lesson proposal 1.0",
  "type": "object",
  "required": [
    "lesson_id", "observation", "applicability", "confidence", "review_state",
    "evidence_ids", "source_event_ids"
  ],
  "properties": {
    "lesson_id": { "type": "string", "minLength": 1 },
    "observation": { "type": "string", "minLength": 1 },
    "applicability": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "destination": { "type": ["string", "null"] },
    "review_state": { "enum": ["proposed", "approved", "rejected"] },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
