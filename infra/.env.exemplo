# Copie para .env e troque os valores. O .env NÃO é versionado.
#
# O BRD nomeou "credenciais em texto puro no código versionado" como um dos
# três defeitos do script legado — que usava minioadmin/minioadmin escrito
# no meio do SparkSession.builder. Repetir isso aqui seria copiar o bug
# junto com a arquitetura (Regra 6).
#
# Para gerar uma senha:
#   openssl rand -hex 24

MINIO_USER=troque-me
MINIO_PASSWORD=troque-me-por-algo-longo
