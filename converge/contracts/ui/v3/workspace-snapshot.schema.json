{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converge.dev/contracts/ui/v3/workspace-snapshot.schema.json",
  "title": "Converge WorkspaceSnapshot 3.0",
  "description": "Canonical read-only semantic projection emitted at cvg snapshot --json data.snapshot. WorkspaceSnapshot 3.0 adds typed Pass 3 decomposition; artifact contents and frontend layout remain intentionally excluded.",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "observedAt",
    "source",
    "project",
    "method",
    "review",
    "decomposition",
    "work",
    "execution",
    "receipts",
    "health",
    "signals",
    "issues",
    "authorization",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^ws3_[0-9a-f]{32}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "workspace",
        "fixture"
      ]
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    },
    "decomposition": {
      "$ref": "#/$defs/decomposition"
    },
    "work": {
      "$ref": "#/$defs/work"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "receipts": {
      "$ref": "#/$defs/receipts"
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifact_[0-9a-f]{20}$"
      },
      "uniqueItems": true
    },
    "availability": {
      "enum": [
        "available",
        "empty",
        "unavailable"
      ]
    },
    "entity": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "project",
            "pass",
            "task",
            "run",
            "receipt",
            "health",
            "signal",
            "issue",
            "artifact",
            "swimlane",
            "leg"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "root",
        "lane",
        "git",
        "artifactIds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "enum": [
            "FULL",
            "NORMAL",
            "FAST"
          ]
        },
        "git": {
          "type": "object",
          "required": [
            "available",
            "root",
            "branch",
            "commit",
            "dirty"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "root": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "command",
        "token",
        "verdict",
        "exitCode",
        "ok"
      ],
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ok": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "required": [
        "id",
        "order",
        "label",
        "summary",
        "optional",
        "status",
        "gate",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pass-[0-8]$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "complete",
            "active",
            "blocked",
            "waiting",
            "optional",
            "skipped"
          ]
        },
        "gate": {
          "$ref": "#/$defs/gate"
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^pass-[0-8]$"
        },
        "target": {
          "type": "string",
          "pattern": "^pass-[0-8]$"
        },
        "kind": {
          "enum": [
            "required",
            "optional",
            "bypass"
          ]
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "name",
        "version",
        "activePassId",
        "passes",
        "edges"
      ],
      "properties": {
        "name": {
          "const": "Converge"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "activePassId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^pass-[0-8]$"
            }
          ]
        },
        "passes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/pass"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "additionalProperties": false
    },
    "reviewObjection": {
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "resolved",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "boolean"
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "openQuestion": {
      "type": "object",
      "required": [
        "id",
        "question",
        "owner",
        "blocksBuild"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "blocksBuild": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "verdict",
        "round",
        "unresolvedCount",
        "objections",
        "openQuestions",
        "artifactIds"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "minLength": 1
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "objections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewObjection"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openQuestion"
          }
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "effort",
        "priority",
        "agent",
        "budgetIterations",
        "dependsOn",
        "signedOff",
        "dispatchable",
        "blockingReasons",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "budgetIterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "signedOff": {
          "type": "boolean"
        },
        "dispatchable": {
          "type": "boolean"
        },
        "blockingReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "required": [
        "availability",
        "tasks",
        "frontier",
        "stats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "frontier": {
          "type": "object",
          "required": [
            "taskIds",
            "blockedTaskIds"
          ],
          "properties": {
            "taskIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "blockedTaskIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "required": [
            "total",
            "ready",
            "inProgress",
            "blocked",
            "done",
            "parked"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "ready": {
              "type": "integer",
              "minimum": 0
            },
            "inProgress": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            },
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "parked": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "taskId",
        "state",
        "attempt",
        "budgetIterations",
        "runtime",
        "checkpoint",
        "terminal",
        "handoffArtifactId",
        "profileArtifactId",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budgetIterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "runtime": {
          "type": "object",
          "required": [
            "primaryRuntime",
            "assurance"
          ],
          "properties": {
            "primaryRuntime": {
              "type": [
                "string",
                "null"
              ]
            },
            "assurance": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "attempt",
                "strikes",
                "tokensUsed",
                "startedAtEpoch",
                "elapsedSeconds",
                "artifactId"
              ],
              "properties": {
                "attempt": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "strikes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "tokensUsed": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "startedAtEpoch": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "elapsedSeconds": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "artifactId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "terminal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "result",
                "recordedAt"
              ],
              "properties": {
                "result": {
                  "type": "string",
                  "minLength": 1
                },
                "recordedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "handoffArtifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileArtifactId": {
          "type": "string"
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "availability",
        "runs"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      },
      "additionalProperties": false
    },
    "digestBinding": {
      "type": "object",
      "required": [
        "path",
        "expectedSha256",
        "currentSha256",
        "matches"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "matches": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "id",
        "taskId",
        "result",
        "recordedAt",
        "integrity",
        "freshness",
        "bindings",
        "provenance",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "integrity": {
          "enum": [
            "verified",
            "mismatch",
            "unavailable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unavailable"
          ]
        },
        "bindings": {
          "type": "object",
          "required": [
            "task",
            "executionProfile",
            "evaluationOutputSha256",
            "pathPolicy"
          ],
          "properties": {
            "task": {
              "$ref": "#/$defs/digestBinding"
            },
            "executionProfile": {
              "$ref": "#/$defs/digestBinding"
            },
            "evaluationOutputSha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "pathPolicy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "generatedBy",
            "postHoc"
          ],
          "properties": {
            "generatedBy": {
              "type": [
                "string",
                "null"
              ]
            },
            "postHoc": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "receipts": {
      "type": "object",
      "required": [
        "availability",
        "items"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          }
        }
      },
      "additionalProperties": false
    },
    "healthCheck": {
      "type": "object",
      "required": [
        "id",
        "component",
        "status",
        "required",
        "summary",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "blocked",
            "unavailable",
            "empty"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": [
        "overall",
        "checks"
      ],
      "properties": {
        "overall": {
          "enum": [
            "healthy",
            "degraded",
            "blocked"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/healthCheck"
          }
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "severity",
        "summary",
        "occurredAt",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "gate",
            "task",
            "run",
            "receipt",
            "git"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "entity": {
          "$ref": "#/$defs/entity"
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "code",
        "severity",
        "domain",
        "message",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^issue_[0-9a-f]{20}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocking"
          ]
        },
        "domain": {
          "enum": [
            "project",
            "method",
            "review",
            "decomposition",
            "work",
            "execution",
            "receipts",
            "health",
            "authorization"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "#/$defs/entity"
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "artifactIds": {
          "$ref": "#/$defs/artifactIds"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "state",
        "nextPassId",
        "command",
        "mutation",
        "dryRunSupported",
        "enabled",
        "rationale",
        "blockingIssueIds"
      ],
      "properties": {
        "state": {
          "enum": [
            "allowed",
            "blocked",
            "complete",
            "unknown"
          ]
        },
        "nextPassId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
