{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converge.dev/contracts/converge-cli-result-v1.schema.json",
  "title": "ConvergeCLIResult/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "ok",
    "command",
    "converge_pass",
    "token",
    "verdict",
    "exit_code",
    "changed",
    "dry_run",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "contract": {"const": "ConvergeCLIResult/v1"},
    "schema_version": {"const": 1},
    "ok": {"type": "boolean"},
    "command": {"type": "string", "minLength": 1},
    "converge_pass": {"type": ["integer", "string", "null"]},
    "token": {"type": ["string", "null"]},
    "verdict": {"type": ["string", "null"]},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "changed": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "data": {"type": "object"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "cvg_version"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "tool": {"const": "cvg"},
        "cvg_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
