          },
          "scenario": {
            "enum": [
              "valid-minimal",
              "valid-boundary",
              "malformed",
              "rounding-half-up",
              "DF-SOURCE-005"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scenario": {
                  "enum": [
