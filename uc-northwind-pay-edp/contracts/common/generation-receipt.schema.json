  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalMoney": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
      "not": {
        "const": "-0.00"
      }
    },
    "canonicalUnsignedMoney": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
    },
    "canonicalReturnedMoney": {
      "oneOf": [
        {
          "const": "0.00"
        },
        {
          "type": "string",
          "pattern": "^-(?:0\\.(?!00$)[0-9]{2}|[1-9][0-9]{0,15}\\.[0-9]{2})$"
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_file",
        "data_file",
        "data_sha256",
        "source_manifest",
        "source_manifest_sha256"
      ],
      "properties": {
        "checksum_file": {
          "type": "string"
        },
        "data_file": {
          "type": "string"
        },
        "data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest": {
          "const": "source-manifest.json"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "type01Artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_file",
        "data_file",
        "data_sha256",
        "source_manifest",
        "source_manifest_sha256"
      ],
      "properties": {
        "checksum_file": {
          "type": "string",
          "pattern": "^NW_CARD_SETTLEMENT_[0-9]{8}_B[0-9]{15}\\.dat\\.sha256$"
        },
        "data_file": {
          "type": "string",
          "pattern": "^NW_CARD_SETTLEMENT_[0-9]{8}_B[0-9]{15}\\.dat$"
        },
        "data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest": {
          "const": "source-manifest.json"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "type02Artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_file",
        "data_file",
        "data_sha256",
        "source_manifest",
        "source_manifest_sha256"
      ],
      "properties": {
        "checksum_file": {
          "type": "string",
          "pattern": "^NW_INSTANT_PAYMENT_[0-9]{8}_B[0-9]{15}\\.txt\\.sha256$"
        },
        "data_file": {
          "type": "string",
          "pattern": "^NW_INSTANT_PAYMENT_[0-9]{8}_B[0-9]{15}\\.txt$"
        },
        "data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest": {
          "const": "source-manifest.json"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_sha256",
        "layout_version",
        "registry_sha256",
        "type_number",
        "version"
      ],
      "properties": {
        "layout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "layout_version": {
          "const": "001"
        },
        "registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "type_number": {
          "enum": [
            "01",
            "02",
            "03",
            "04",
            "05",
            "06"
          ]
        },
        "version": {
          "const": 1
        }
      }
    },
    "type01Controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computed_detail_count",
        "computed_net_amount",
        "declared_detail_count",
        "declared_net_amount"
      ],
      "properties": {
        "computed_detail_count": {
          "type": "integer",
          "minimum": 1
        },
        "computed_net_amount": {
          "oneOf": [
            {
              "$ref": "#/$defs/canonicalMoney"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_detail_count": {
          "type": "integer",
          "minimum": 1
        },
        "declared_net_amount": {
          "$ref": "#/$defs/canonicalMoney"
        }
      }
    },
    "type01ExpectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "violation"
      ],
      "properties": {
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "violation": {
          "enum": [
            null,
            "INVALID_OVERPUNCH",
            "SOURCE_CONTROL_TOTAL_MISMATCH"
          ]
        }
      }
    },
    "type01Fault": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "expected_stage",
            "injected"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_OVERPUNCH",
                "SOURCE_CONTROL_TOTAL_MISMATCH"
              ]
            },
            "expected_stage": {
              "const": "java-validation"
            },
            "injected": {
              "const": true
            }
          }
        }
      ]
    },
    "type02Controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computed_credit_amount",
        "computed_debit_amount",
        "computed_event_count",
        "computed_net_amount",
        "declared_credit_amount",
        "declared_debit_amount",
        "declared_event_count",
        "declared_net_amount"
      ],
      "properties": {
        "computed_credit_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "computed_debit_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "computed_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "computed_net_amount": {
          "$ref": "#/$defs/canonicalMoney"
        },
        "declared_credit_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "declared_debit_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "declared_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "declared_net_amount": {
          "$ref": "#/$defs/canonicalMoney"
        }
      }
    },
    "type02ExpectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "violation"
      ],
      "properties": {
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "violation": {
          "enum": [
            null,
            "INVALID_FIELD_COUNT",
            "SOURCE_CONTROL_NET_MISMATCH"
          ]
        }
      }
    },
    "type02Fault": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "expected_stage",
            "injected"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_FIELD_COUNT",
                "SOURCE_CONTROL_NET_MISMATCH"
              ]
            },
            "expected_stage": {
              "const": "java-validation"
            },
            "injected": {
              "const": true
            }
          }
        }
      ]
    },
    "type03Artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_file",
        "data_file",
        "data_sha256",
        "source_manifest",
        "source_manifest_sha256"
      ],
      "properties": {
        "checksum_file": {
          "type": "string",
          "pattern": "^NW_PAYMENT_SLIP_[0-9]{8}_B[0-9]{15}\\.rem\\.sha256$"
        },
        "data_file": {
          "type": "string",
          "pattern": "^NW_PAYMENT_SLIP_[0-9]{8}_B[0-9]{15}\\.rem$"
        },
        "data_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest": {
          "const": "source-manifest.json"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "type03Controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computed_discount_amount",
        "computed_face_amount",
        "computed_fee_amount",
        "computed_logical_count",
        "computed_lot_count",
        "computed_net_amount",
        "computed_orphan_segment_count",
