{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northwind-pay.local/contracts/generation-receipt-v1.schema.json",
  "title": "NorthWind Pay generation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "batch_id",
    "contract",
    "controls",
    "expected_contract_result",
    "fault",
    "generator",
    "scenario",
    "schema_version",
    "status"
  ],
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^B[0-9]{15}$"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "controls": {
      "type": "object"
    },
    "expected_contract_result": {
      "type": "object"
    },
    "fault": {
      "type": [
        "object",
        "null"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "northwind-pay-datagen"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "generated"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "type_number": {
                "const": "01"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "$ref": "#/$defs/type01Artifacts"
          },
          "controls": {
            "$ref": "#/$defs/type01Controls"
          },
          "expected_contract_result": {
            "$ref": "#/$defs/type01ExpectedResult"
          },
          "fault": {
            "$ref": "#/$defs/type01Fault"
          },
          "scenario": {
            "enum": [
              "valid-minimal",
              "valid-boundary",
              "negative-overpunch",
              "malformed",
              "DF-SOURCE-001"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scenario": {
                  "enum": [
                    "valid-minimal",
                    "valid-boundary",
                    "negative-overpunch"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "expected_contract_result": {
                  "const": {
                    "status": "ACCEPTED",
                    "violation": null
                  }
                },
                "fault": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "malformed"
                }
              }
            },
            "then": {
              "properties": {
                "expected_contract_result": {
                  "const": {
                    "status": "REJECTED",
                    "violation": "INVALID_OVERPUNCH"
                  }
                },
                "fault": {
                  "const": {
                    "code": "INVALID_OVERPUNCH",
                    "expected_stage": "java-validation",
                    "injected": true
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "DF-SOURCE-001"
                }
              }
            },
            "then": {
              "properties": {
                "expected_contract_result": {
                  "const": {
                    "status": "REJECTED",
                    "violation": "SOURCE_CONTROL_TOTAL_MISMATCH"
                  }
                },
                "fault": {
                  "const": {
                    "code": "SOURCE_CONTROL_TOTAL_MISMATCH",
                    "expected_stage": "java-validation",
                    "injected": true
                  }
                }
              }
            }
          }
