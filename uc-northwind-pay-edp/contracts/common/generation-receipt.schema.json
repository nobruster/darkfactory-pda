                  }
                },
                "fault": {
                  "const": {
                    "code": "SOURCE_CONTROL_NET_MISMATCH",
                    "expected_stage": "java-validation",
                    "injected": true
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "type_number": {
                "const": "05"
              }
            }
          }
