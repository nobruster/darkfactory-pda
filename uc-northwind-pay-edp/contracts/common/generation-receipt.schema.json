          },
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "DF-SOURCE-003"
                }
              }
            },
            "then": {
              "properties": {
                "expected_contract_result": {
                  "const": {
                    "status": "REJECTED",
                    "violation": "SOURCE_CONTROL_NET_MISMATCH"
                  }
                },
                "fault": {
                  "const": {
                    "code": "SOURCE_CONTROL_NET_MISMATCH",
                    "expected_stage": "java-validation",
                    "injected": true
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "type_number": {
                "const": "04"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "$ref": "#/$defs/type04Artifacts"
          },
          "controls": {
