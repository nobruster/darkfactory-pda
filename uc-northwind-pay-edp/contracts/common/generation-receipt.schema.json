                    "violation": "INVALID_TRANSPORT"
                  }
                },
                "fault": {
                  "const": {
                    "code": "INVALID_TRANSPORT",
                    "expected_stage": "java-validation",
                    "injected": true
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "DF-SOURCE-004"
                }
              }
            },
            "then": {
              "properties": {
                "expected_contract_result": {
                  "const": {
                    "status": "REJECTED",
