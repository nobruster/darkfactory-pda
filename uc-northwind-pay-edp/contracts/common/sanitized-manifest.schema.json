          "type": "string",
          "pattern": "^NW_PAYMENT_SLIP_[0-9]{8}_B[0-9]{15}\\.rem$"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "type03CsvFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "name",
        "row_count",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "encoding": {
          "const": "UTF-8"
        },
        "name": {
          "type": "string",
          "pattern": "^NW_PAYMENT_SLIP_[0-9]{8}_B[0-9]{15}\\.csv$"
