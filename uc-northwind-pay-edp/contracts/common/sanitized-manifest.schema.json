      ],
      "properties": {
        "encoding": {
          "const": "UTF-8"
        },
        "name": {
          "type": "string",
          "pattern": "^NW_MERCHANT_FEES_[0-9]{8}_B[0-9]{15}_SANITIZED\\.csv$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "unicode_normalization": {
          "const": "NFC"
        }
      }
    },
    "type05FileType": {
      "type": "object",
