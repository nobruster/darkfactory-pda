        },
        "discount_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "face_amount": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalUnsignedMoney"
            },
            {
              "not": {
                "const": "0.00"
              }
            }
          ]
        },
        "fee_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "net_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "orphan_segment_count": {
          "const": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "type04SourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "raw_file",
        "raw_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_file": {
          "type": "string",
          "pattern": "^NW_TED_SETTLEMENT_[0-9]{8}_B[0-9]{15}\\.dat$"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "type04CsvFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "name",
        "row_count",
