    "type04StageControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "gross_amount",
        "net_amount",
        "return_amount",
        "return_count",
        "row_count",
        "transfer_count"
      ],
      "properties": {
        "currency": {
          "const": "BRL"
        },
        "gross_amount": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalUnsignedMoney"
            },
            {
              "not": {
                "const": "0.00"
              }
            }
          ]
        },
        "net_amount": {
          "$ref": "#/$defs/canonicalUnsignedMoney"
        },
        "return_amount": {
          "$ref": "#/$defs/canonicalReturnedMoney"
        },
        "return_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "transfer_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
