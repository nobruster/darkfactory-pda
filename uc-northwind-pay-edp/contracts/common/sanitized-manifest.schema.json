        "contract_version": {
          "const": 1
        },
        "layout_version": {
          "const": "001"
        },
        "number": {
          "const": "05"
        }
      }
    },
    "type05StageControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessed_fee",
        "calculated_fee",
        "currency",
        "gross_amount",
