# Local synthetic environment only. Copy to .env with `make init`.
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
SFTP_RAW_PUBLISHER_USER=raw-publisher
SFTP_RAW_PUBLISHER_PASSWORD=local-raw-publisher
SFTP_PROCESSOR_USER=processor
SFTP_PROCESSOR_PASSWORD=local-processor
SFTP_LOADER_USER=loader
SFTP_LOADER_PASSWORD=local-loader
SFTP_OPERATOR_USER=operator
SFTP_OPERATOR_PASSWORD=local-operator

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=northwind_legacy
POSTGRES_ADMIN_USER=northwind_admin
POSTGRES_ADMIN_PASSWORD=local-northwind-admin
POSTGRES_USER=northwind_loader
POSTGRES_PASSWORD=local-northwind-loader

# Public deterministic key from the synthetic fixture contract. Never use it
# for production data or outside this local test environment.
NWP_TOKENIZATION_KEY=northwind-pay-edp-fixture-key-v1
NWP_DOCUMENT_TOKEN_KEY=northwind-pay-edp-fixture-document-key-v1
NWP_PAYMENT_REFERENCE_KEY=northwind-pay-edp-fixture-payment-reference-key-v1
NWP_PARTY_TOKEN_KEY=northwind-pay-edp-fixture-party-key-v1
NWP_ACCOUNT_TOKEN_KEY=northwind-pay-edp-fixture-account-key-v1
NWP_TED_ACCOUNT_TOKEN_KEY=northwind-pay-edp-fixture-ted-account-key-v1
